# ========================================================
# Gateway Gas — Environment Configuration
# ========================================================
# Separate projects recommended for Production vs Staging/Preview/Testing

# Supabase API Settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: M-Pesa Daraja STK Push Configuration
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-passkey
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/mpesa/callback

# Environment identifier (production | preview | test)
NEXT_PUBLIC_APP_ENV=production
