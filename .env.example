# ==============================================================================
# Gateway Gas — Enterprise Environment Configuration Guide
# ==============================================================================
# Separate projects are required for Production vs Testing / Vercel Preview.
# Set these in your Vercel Project Dashboard: Project -> Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. DEMO & TESTING MODE SWITCH
# ------------------------------------------------------------------------------
# Set to 'true' in Local (.env.local) and Vercel PREVIEW environments.
# Set to 'false' (or leave unset) in Vercel PRODUCTION.
# When false: all demo switchers, 1-tap test buttons, and reset helpers are
# completely tree-shaken and excluded from the production JavaScript bundle.
NEXT_PUBLIC_DEMO_MODE=true

# Environment identifier: 'development' | 'preview' | 'production'
NEXT_PUBLIC_APP_ENV=preview

# ------------------------------------------------------------------------------
# 2. SUPABASE API CREDENTIALS
# ------------------------------------------------------------------------------
# For Production: Use your primary production Supabase project (e.g. stziykrxtijojtnmhcoy).
# For Preview/Staging: Use a dedicated staging/test Supabase project seeded with supabase/seed.sql.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...

# ------------------------------------------------------------------------------
# 3. M-PESA DARAJA STK PUSH (Safaricom Integration)
# ------------------------------------------------------------------------------
# Sandbox credentials for Preview / Testing; Live credentials for Production.
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_PASSKEY=your_daraja_passkey
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/mpesa/callback

# ==============================================================================
# VERCEL ENVIRONMENT TARGETS MATRIX
# ==============================================================================
# Variable                  | Preview / Staging Branch | Production (main)
# --------------------------+--------------------------+-----------------------
# NEXT_PUBLIC_DEMO_MODE     | true                     | false
# NEXT_PUBLIC_APP_ENV       | preview                  | production
# NEXT_PUBLIC_SUPABASE_URL  | [Staging Supabase URL]   | [Production Supabase URL]
# NEXT_PUBLIC_SUPABASE_ANON | [Staging Anon Key]       | [Production Anon Key]
# SUPABASE_SERVICE_ROLE_KEY | [Staging Service Key]    | [Production Service Key]
# MPESA_SHORTCODE           | 174379 (Sandbox)         | Live Business Till/Paybill
# ==============================================================================
